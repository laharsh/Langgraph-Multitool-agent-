# Agent: Groq recommended (tool calling + no local GPU crashes)
LLM_PROVIDER=groq
# Optional fallback if Ollama works on your machine:
# LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Project 1 RAG API (start rag-eval-platform on port 8000 first)
RAG_API_URL=http://localhost:8000/ask

# This project's REST API (Phase 3)
API_PORT=8001
GRPC_PORT=50051
MAX_AGENT_LOOPS=5

# SQLite business data
DB_PATH=data/company.db
